-- A model no configuration settles inside the budget, so that every
-- arm of an experiment runs for the same length of time.
--
-- Engine count and run length have been entangled in every arm so far:
-- fewer engines settle the properties sooner, so they run for less
-- time, so they see fewer freezes -- and a zero cannot be told from a
-- short run. Here nothing settles anything: each property is false,
-- but only after about a million steps, so bounded model checking
-- cannot unroll to it inside the budget and induction cannot prove
-- what is false. Every engine works and none finishes.
--
-- Sixteen of them, so that the engines have enough to be busy with.

node prop0 (u : bool) returns (ok : bool);
var c : int; d : int;
let
  c = 0 -> pre c + 1;
  d = 0 -> pre d + 1 + (if pre c > 500 then 0 else 1);
  ok = (c < 1000000) and (d >= c);
  --%PROPERTY ok;
tel

