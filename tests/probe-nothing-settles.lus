node top (u : bool) returns (ok : bool);
var o0 : bool; o1 : bool; o2 : bool; o3 : bool; o4 : bool; o5 : bool; o6 : bool; o7 : bool; o8 : bool; o9 : bool; o10 : bool; o11 : bool; o12 : bool; o13 : bool; o14 : bool; o15 : bool;
let
  o0 = prop0(u);
  o1 = prop1(u);
  o2 = prop2(u);
  o3 = prop3(u);
  o4 = prop4(u);
  o5 = prop5(u);
  o6 = prop6(u);
  o7 = prop7(u);
  o8 = prop8(u);
  o9 = prop9(u);
  o10 = prop10(u);
  o11 = prop11(u);
  o12 = prop12(u);
  o13 = prop13(u);
  o14 = prop14(u);
  o15 = prop15(u);
  ok = o0 and o1 and o2 and o3 and o4 and o5 and o6 and o7 and o8 and o9 and o10 and o11 and o12 and o13 and o14 and o15;
  --%MAIN;
  --%PROPERTY ok;
tel
